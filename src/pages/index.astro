---
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Ishaan Kataria | Developer &amp; Co-founder</title>
    <meta name="description" content="Ishaan Kataria, co-founder of Constance and full-stack developer in Melbourne. Commerce &amp; IT at Monash University." />
    <meta property="og:title" content="Ishaan Kataria | Developer &amp; Co-founder" />
    <meta property="og:description" content="Co-founder of Constance and full-stack developer in Melbourne." />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=clash-display@500,600,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#projects" class="skip-link">Skip to content</a>

    <!-- Navigation -->
    <nav class="navbar" id="navbar">
      <a href="#hero" class="nav-logo">IK</a>
      <div class="nav-links">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#awards">Awards</a>
        <a href="#experience">Experience</a>
      </div>
      <a href="#contact" class="nav-cta" aria-label="Contact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
    </nav>

    <!-- Mobile Navigation -->
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span>
    </button>
    <div class="mobile-overlay" id="mobile-overlay">
      <nav>
        <a href="#hero" class="mobile-link">Home</a>
        <a href="#projects" class="mobile-link">Projects</a>
        <a href="#about" class="mobile-link">About</a>
        <a href="#skills" class="mobile-link">Skills</a>
        <a href="#awards" class="mobile-link">Awards</a>
        <a href="#experience" class="mobile-link">Experience</a>
        <a href="#contact" class="mobile-link">Contact</a>
        <a href="/Ishaan_Kataria_Resume.pdf" download class="mobile-link" style="color: var(--color-coral);">Download Resume</a>
      </nav>
    </div>

    <!-- ===== HERO ===== -->
    <section id="hero" class="hero">
      <div class="hero-container">
        <p class="hero-label reveal">Co-founder @ Constance / Melbourne, AU</p>
        <h1 class="hero-heading reveal reveal-d1">
          Hi, I'm <span class="hl-coral">Ishaan Kataria</span>, a developer and co-founder from <span class="hl-blue">Melbourne</span>
        </h1>
        <p class="hero-desc reveal reveal-d2">
          I'm building Constance, a Melbourne healthtech working on the weeks between hospital and home. Studying Commerce &amp; IT at Monash and shipping software along the way.
        </p>
        <div class="hero-actions reveal reveal-d3">
          <a href="#contact" class="btn-dark">
            Get In Touch
          </a>
          <a href="/Ishaan_Kataria_Resume.pdf" download class="btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Resume
          </a>
        </div>
      </div>
    </section>

    <!-- ===== PROJECTS ===== -->
    <section id="projects" class="section">
      <div class="section-container">
        <h2 class="section-heading reveal">Selected <span class="hl-coral">Projects</span></h2>

        <div class="projects-list">
          <!-- Constance -->
          <article class="project-card reveal">
            <div class="project-info">
              <span class="badge badge--live">1st &middot; Startmate Student Founder Bootcamp</span>
              <h3 class="project-title">Constance</h3>
              <p class="project-tagline">Support for the Weeks Between Hospital and Home</p>
              <p class="project-desc">
                Too many people end up back in hospital in the weeks after going home, for things that could have been caught earlier. I co-founded Constance with two others at the Startmate Student Founder Bootcamp, where we validated the problem with a cardiologist, a surgeon and a health insurer in 36 hours and won the final pitch out of ~60 students. I lead product and tech. I built our demo, an AI text companion that answers only from a person's own discharge plan, with a dashboard for their care team, and designed the setup for keeping health data in Australia.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">TypeScript</span>
                <span class="tag">Cloudflare Workers</span>
                <span class="tag">OpenAI API</span>
                <span class="tag">AWS</span>
              </div>
              <div class="project-links">
                <a href="https://constancehealth.au" target="_blank" rel="noopener" class="link-arrow">
                  Visit the website
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
            <div class="project-visual" style="background-color: #1B3A6B;">
              <img src="/projects/constance.png" alt="Constance website homepage: too many people end up back in hospital in the weeks after going home" />
            </div>
          </article>

          <!-- Watchlist -->
          <article class="project-card reveal">
            <div class="project-visual" style="background-color: #FACC15;">
              <img src="/projects/watchlist.jpg" alt="Watchlist search results for Dune, showing film posters with ratings and add buttons" />
            </div>
            <div class="project-info">
              <span class="badge badge--live">Live</span>
              <h3 class="project-title">Watchlist</h3>
              <p class="project-tagline">Film Tracker with an AI Taste Profile</p>
              <p class="project-desc">
                A Letterboxd-style film tracker I built for myself. Search any film, keep a to-watch list, rate what you've seen, and get stats plus an AI taste profile that suggests what to watch next based on your ratings. You can follow friends, see what they're watching in a feed, and check how closely your taste matches theirs. Every table is locked down with row-level security, so you only ever see data from people you follow.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">TypeScript</span>
                <span class="tag">Supabase</span>
                <span class="tag">Claude API</span>
                <span class="tag">Playwright</span>
              </div>
              <div class="project-links">
                <a href="https://watchlist-ashen-ten.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="https://github.com/IshaanKataria/watchlist" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Vacationer -->
          <article class="project-card project-card--compact reveal">
            <div class="project-info">
              <span class="badge badge--live">Live</span>
              <h3 class="project-title">Vacationer</h3>
              <p class="project-tagline">Australian Internship and Graduate Role Tracker</p>
              <p class="project-desc">
                Finding internships in Australia meant digging through listings stuck behind logins and ranked by which employer paid the most. Vacationer is a free tracker of 36 curated programs sorted by what closes next. A weekly GitHub Actions job re-checks every listing with the Claude API and deploys the updates by itself, and it has run unattended since July.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">Tailwind CSS</span>
                <span class="tag">Claude API</span>
                <span class="tag">GitHub Actions</span>
              </div>
              <div class="project-links">
                <a href="https://vacationer-tracker.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="https://github.com/IshaanKataria/vacationer-tracker" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Belongity -->
          <article class="project-card project-card--compact reveal">
            <div class="project-info">
              <span class="badge badge--live">Best Pitch &middot; Canva Hackathon 2026</span>
              <h3 class="project-title">Belongity</h3>
              <p class="project-tagline">Student Belonging Platform</p>
              <p class="project-desc">
                Starting university is isolating, and most "belonging" support kicks in too late. Belongity matches incoming students into small peer "pods" before they even arrive, using onboarding quizzes to pair people who'll actually click, then keeps them engaged with weekly connection quests. It's mobile-first and built to feel warm, not institutional. We won Best Pitch at the Canva-sponsored hackathon at Monash's The Generator.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">TypeScript</span>
                <span class="tag">Tailwind CSS</span>
                <span class="tag">Framer Motion</span>
              </div>
              <div class="project-links">
                <a href="https://belongity.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="https://github.com/IshaanKataria/belongity" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- StockAnalyser -->
          <article class="project-card reveal">
            <div class="project-info">
              <span class="badge badge--live">Live</span>
              <h3 class="project-title">StockAnalyser</h3>
              <p class="project-tagline">AI-Powered Financial Text Analysis</p>
              <p class="project-desc">
                I wanted a quick way to break down earnings reports and news articles without reading through pages of text. So I built a tool that takes any financial text, runs it through GPT-4o-mini, and pulls out sentiment, key insights, risk factors, and a summary you can actually act on. Three analysis modes, dark theme, and you can export everything as JSON.
              </p>
              <div class="tag-row">
                <span class="tag">Python</span>
                <span class="tag">FastAPI</span>
                <span class="tag">OpenAI API</span>
                <span class="tag">JavaScript</span>
              </div>
              <div class="project-links">
                <a href="https://github.com/IshaanKataria/stockanalyser" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a href="https://stockanalyser-seven.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
            <div class="project-visual" style="background-color: #FF4A60;">
              <img src="/projects/stockanalyser.png" alt="StockAnalyser dark-themed analysis interface" />
            </div>
          </article>

          <!-- SiteVoice -->
          <article class="project-card reveal">
            <div class="project-info">
              <span class="badge">7th of 155 &middot; Sophiie AI Hackathon / Solo</span>
              <h3 class="project-title">SiteVoice</h3>
              <p class="project-tagline">Voice-First AI Assistant for Tradies</p>
              <p class="project-desc">
                Plumbers lose hours every week on admin when they should be on the tools. I built SiteVoice so they can create quotes just by talking. Say something like "Dave needs a hot water replacement, Rheem 250L, add a tempering valve" and it builds a full itemized quote with real pricing and GST. Shipped in a solo-only 33-hour hackathon, then refactored into a self-contained persistent app backed by SQLite with tool-call telemetry.
              </p>
              <div class="tag-row">
                <span class="tag">Python</span>
                <span class="tag">Streamlit</span>
                <span class="tag">OpenAI GPT-4o</span>
                <span class="tag">Whisper STT</span>
                <span class="tag">SQLite</span>
              </div>
              <div class="project-links">
                <a href="https://sitevoice.streamlit.app" target="_blank" rel="noopener" class="link-arrow">
                  Try the live demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="https://github.com/IshaanKataria/sitevoice" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
            <div class="project-visual" style="background-color: #6366F1;">
              <img src="/projects/sitevoice.png" alt="SiteVoice voice assistant interface for plumber quoting" />
            </div>
          </article>

          <!-- SafeWalk -->
          <article class="project-card project-card--compact reveal">
            <div class="project-info">
              <span class="badge">Macathon 2026</span>
              <h3 class="project-title">SafeWalk</h3>
              <p class="project-tagline">Walking-Route Safety Scorer</p>
              <p class="project-desc">
                A lot of people change how they walk home at night based on gut feel. SafeWalk turns that into data. It scores walking routes for safety using ML heatmaps trained on incident data, layers in community-submitted reports, and surfaces the safer path rather than just the fastest one. Built across a Next.js frontend, a FastAPI backend, and a PostGIS database, with an XGBoost model doing the scoring.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">FastAPI</span>
                <span class="tag">PostgreSQL / PostGIS</span>
                <span class="tag">XGBoost</span>
              </div>
              <div class="project-links">
                <a href="https://frontend-topaz-pi-18.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="https://github.com/IshaanKataria/SafeWalk" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- GroupChatWrapped -->
          <article class="project-card project-card--compact reveal">
            <div class="project-info">
              <span class="badge">HackMelbourne 2026</span>
              <h3 class="project-title">GroupChatWrapped</h3>
              <p class="project-tagline">Spotify Wrapped, but for Your Group Chat</p>
              <p class="project-desc">
                Everyone's group chat has a personality. GroupChatWrapped exposes it. Drop in an exported WhatsApp group chat and it generates a Spotify-Wrapped-style breakdown: who carries the conversation, the night-owl, the ghost, peak chaos hours, plus AI-written stats and shareable cards. Built in a weekend with Next.js 16, React 19, and the Claude API doing the narrative generation.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js 16</span>
                <span class="tag">React 19</span>
                <span class="tag">Tailwind v4</span>
                <span class="tag">Framer Motion</span>
                <span class="tag">Claude API</span>
              </div>
              <div class="project-links">
                <a href="https://groupchatwrapped.vercel.app" target="_blank" rel="noopener" class="link-arrow">
                  Live Demo
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Ember -->
          <article class="project-card reveal">
            <div class="project-visual" style="background-color: #FFC224;">
              <img src="/projects/ember.png" alt="Ember elderly care dashboard showing medication tracking and video calling" />
            </div>
            <div class="project-info">
              <span class="badge">UNIHACK 2026</span>
              <h3 class="project-title">Ember</h3>
              <p class="project-tagline">Elderly Care Platform with Real-Time Translation</p>
              <p class="project-desc">
                Built this with a team of 6 at UNIHACK. It's an elderly care platform where seniors can video call family with a single tap, and the call gets translated in real time across 13+ languages. We self-hosted the whole translation pipeline and got it under 550ms latency. Also has medication reminders, mood tracking, and a dashboard that nudges family when something seems off.
              </p>
              <div class="tag-row">
                <span class="tag">Next.js</span>
                <span class="tag">React</span>
                <span class="tag">Go</span>
                <span class="tag">WebRTC</span>
                <span class="tag">PostgreSQL</span>
                <span class="tag">Docker</span>
              </div>
              <div class="project-links">
                <a href="https://github.com/aShanki/unihack2026" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- VolLab -->
          <article class="project-card project-card--compact reveal">
            <div class="project-info">
              <span class="badge badge--outline">In Development</span>
              <h3 class="project-title">VolLab</h3>
              <p class="project-tagline">Options Pricing & Calibration Workbench</p>
              <p class="project-desc">
                Building an options pricing and volatility calibration workbench from scratch. Black-Scholes, Heston model, SVI surface fitting, all implemented from the ground up without black-box libraries.
              </p>
              <div class="tag-row">
                <span class="tag">Python</span>
                <span class="tag">Black-Scholes</span>
                <span class="tag">Heston Model</span>
                <span class="tag">SVI</span>
              </div>
              <div class="project-links">
                <a href="https://github.com/IshaanKataria/vollab" target="_blank" rel="noopener" class="link-arrow">
                  View on GitHub
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="section">
      <div class="section-container">
        <h2 class="section-heading reveal">About <span class="hl-blue">Me</span></h2>

        <div class="about-grid">
          <div class="about-text reveal">
            <p>
              I'm doing a double degree at Monash in Commerce and IT because I couldn't pick one. Turns out that's a feature, not a bug. I think about problems from both the business and technical side, which means I build things people actually want to use.
            </p>
            <p>
              I got into coding through wanting to automate stuff that annoyed me. That turned into building an AI voice assistant for tradies, pulling all-nighters at hackathons, and winning Best Pitch twice, at the Canva hackathon for Belongity and the Australian Grand Prix hackathon for My Lap.
            </p>
            <p>
              I always wanted to build my own company. In October that became Constance: we formed the team at the Startmate Student Founder Bootcamp, won the final pitch, and I now lead product and tech. I'm also a Projects Officer at the Monash Association of Coding, working on open-source tools for Monash students.
            </p>
          </div>
          <div class="reveal reveal-d1">
            <div class="info-card">
              <div class="info-card-row">
                <p class="info-card-label">Location</p>
                <p class="info-card-value">Melbourne, VIC</p>
              </div>
              <div class="info-card-row">
                <p class="info-card-label">University</p>
                <p class="info-card-value">Monash University</p>
              </div>
              <div class="info-card-row">
                <p class="info-card-label">Degree</p>
                <p class="info-card-value">B.Com / B.IT (Double)</p>
              </div>
              <div class="info-card-row">
                <p class="info-card-label">Expected</p>
                <p class="info-card-value">Dec 2028</p>
              </div>
              <div class="info-card-row">
                <p class="info-card-label">WAM</p>
                <p class="info-card-value">Distinction <span style="color: var(--color-coral); font-size: 0.75rem; font-weight: 600;">Average</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SKILLS ===== -->
    <section id="skills" class="section">
      <div class="section-container">
        <h2 class="section-heading reveal">Tech <span class="hl-coral">Stack</span></h2>

